PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for POST /api/account/delete (uses supabase.auth.admin.deleteUser).
# Keep this out of any client-side bundle — service-role key, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# Used by POST /api/chatbot/message (the support chat widget). Free key from
# console.groq.com/keys.
GROQ_API_KEY=your-groq-api-key
# Used by POST /api/payments/charge and the Freelancer Premium checkout
# (POST /api/subscriptions/checkout). Test-mode secret key from
# dashboard.omise.co (Settings > Keys) — never the live key outside of an
# actual production launch, and never committed for real.
OMISE_SECRET_KEY=skey_test_your-omise-secret-key
# Public URL of the frontend (no trailing slash). Freelancer Premium sends
# cards that need 3-D Secure back to <APP_BASE_URL>/freelancer-dashboard/premium
# so the server can confirm the charge with Omise. e.g. https://your-app.vercel.app
APP_BASE_URL=http://localhost:5173
# Leave unset. POST /api/payments/charge (an arbitrary-amount test charge) is
# disabled unless this is "true"; nothing in the app uses it.
# ENABLE_TEST_CHARGE_ENDPOINT=false
